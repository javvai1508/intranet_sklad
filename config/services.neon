services:
	- App\Helpers\HeliosErrorMessages
	-
		create: App\Audit\AuditLog
		arguments:
			appId: %audit.appId%
	- App\Router\RouterFactory::createRouter
	- App\Forms\SignFormFactory
	-
		create: App\Models\DeviceModel
		setup:
			- setAuditLog(@App\Audit\AuditLog)
			- setHeliosErrorMessages(@App\Helpers\HeliosErrorMessages)
	- App\Helpers\DeviceIdentity
	- App\Models\UserModel
	- App\Forms\ReadBarCodeFormFactory
	-
		create: App\Models\MaterialModel
		setup:
			- setAuditLog(@App\Audit\AuditLog)
			- setHeliosErrorMessages(@App\Helpers\HeliosErrorMessages)
	-
		create: App\Models\InventoryModel
		setup:
			- setAuditLog(@App\Audit\AuditLog)
			- setHeliosErrorMessages(@App\Helpers\HeliosErrorMessages)
	-
		create: App\Models\TransferReceiptModel
		setup:
			- setAuditLog(@App\Audit\AuditLog)
			- setHeliosErrorMessages(@App\Helpers\HeliosErrorMessages)
	-
		create: App\Models\DeliveryNoteModel
		setup:
			- setAuditLog(@App\Audit\AuditLog)
			- setHeliosErrorMessages(@App\Helpers\HeliosErrorMessages)
	-
		create: App\Models\ProductionModel
		setup:
			- setAuditLog(@App\Audit\AuditLog)
			- setHeliosErrorMessages(@App\Helpers\HeliosErrorMessages)

search:
	-	in: %appDir%
		classes:
			- *Factory
			- *Facade
