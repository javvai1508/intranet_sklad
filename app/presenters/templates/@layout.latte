<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="request-token" content="{$requestToken}">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>Perner - sklad</title>
        <!-- bootstrap - latest compiled and minified CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <!-- font awesome css -->
        <link href="{$basePath}/css/fontawesome.min.css" rel="stylesheet">
        <link href="{$basePath}/css/fa-regular.min.css" rel="stylesheet">

        <link rel="stylesheet" href="{$basePath}/css/style.css">
    </head>

    <body>
        <div n:foreach="$flashes as $flash" n:class="flash, $flash->type">
            <div class="modal fade flash-modal" tabindex="-1" role="dialog">
                <div class="modal-dialog">
                    <div n:class="modal-content, falsh, $flash->type">
                        <div class="modal-header">
                            <h2 class="modal-title">Upozornění</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
                        </div>
                        <div class="modal-body">
                            {$flash->message|breaklines}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Ok</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row header">
                <div class="col-3">
                    {if $user->isLoggedIn()}
                    <div class="logged">
                        <div class="btn-group">    
                            <button class="btn btn-outline-dark dropdown-toggle" type="button" id="menuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> 
                                <i class="far fa-bars"></i>
                            </button>
                            <div class="dropdown-menu" aria-labelledby="menuButton">
                                <a class="dropdown-item logged-user lg" n:href="Homepage:">{$user->getIdentity()->getData()['fullname']}</a>

                                <a class="dropdown-item" n:if="$presenter->hasAccess('vyroba')" n:href="Production:default"><i class="far fa-inbox-in"></i> Výroba</a>
                                <a class="dropdown-item" n:if="$presenter->hasAccess('skladMenu')" n:href="Material:default"><i class="far fa-pallet-alt"></i> Sklad</a>
                                <a class="dropdown-item" n:if="$presenter->hasAccess('admin')" n:href="Settings:default"><i class="far fa-cog"></i> Nastavení</a>
                                <div class="dropdown-item-text small" n:if="$currentDevice">Zařízení: {$currentDevice->Kod}</div>
                                <a class="dropdown-item" n:href="Sign:out"><i class="far fa-sign-out"></i> Odhlásit</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-9">
                    <h1>{isset($nadpis) ? $nadpis : 'Nadpis'}</h1>
                </div>
                {/if}

            </div>

            {include content}
        </div>

        <div class="row footer">
            <div class="col-sm-1 brand"><img src="{$basePath}/images/logo.gif" /></div>
            <div class="col-sm-9"></div>
            <div class="col-sm-2">Intranet&nbsp;sklad&nbsp;20261021.1 ({if $dbInfo}{$dbInfo->databaseName}{/if})</div>
        </div>
        {block scripts}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/nette-forms@3/src/assets/netteForms.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/naja@2/dist/Naja.min.js"></script>

        <script src="{$basePath}/js/main.js"></script>
        {/block}
    </body>
</html>
