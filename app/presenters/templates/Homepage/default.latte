{block content}
<div class="row content">
    <div class="select-app" n:if="$presenter->hasAccess('sklad')">
        <a n:href="DeliveryNote:default"><i class="far fa-truck fa-2x"></i><br><br><span class="sm">Expedice</span></a>
    </div>
    <div class="select-app" n:if="$presenter->hasAccess('vyroba')">
        <a n:href="Production:default"><i class="far fa-inbox-in fa-2x"></i><br><br><span class="sm">Výroba</span></a>
    </div>
    <div class="select-app" n:if="$presenter->hasAccess('skladMenu')">
        <a n:href="Material:default"><i class="far fa-pallet-alt fa-2x"></i><br><br><span class="sm">Sklad</span></a>
    </div>
</div>
