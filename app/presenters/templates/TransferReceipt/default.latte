{block content}
<div class="content">
    <h1>Kontrola příjmu převodů</h1>
    <p>Vyberte výdejku nebo načtěte její číslo. Nabídka obsahuje výdejky odeslané mezi sklady v obou směrech, u kterých ještě není uzavřená kontrola příjmu.</p>
    <div class="mb-3">
        <a n:href="default target => ''" n:class="btn, $target === '' ? btn-primary : btn-outline-primary">Oba sklady</a>
        <a n:href="default target => '00100308'" n:class="btn, $target === '00100308' ? btn-primary : btn-outline-primary">Příjem v Loukově</a>
        <a n:href="default target => '00100304'" n:class="btn, $target === '00100304' ? btn-primary : btn-outline-primary">Příjem ve výchozím skladu</a>
    </div>
    <form n:name="selectDocumentForm" class="mb-3">
        <div class="input-group">
            {input number}
            {input select}
        </div>
        <ul n:if="$form->hasErrors()" class="text-danger">
            <li n:foreach="$form->getErrors() as $error">{$error}</li>
        </ul>
    </form>
    <table class="table table-bordered table-striped">
        <thead><tr><th>Výdejka</th><th>Směr</th><th>Cílový sklad</th><th>Datum</th><th></th></tr></thead>
        <tbody>
            <tr n:foreach="$documents as $document">
                <td>{$document->ParovaciZnak}</td>
                <td>{$document->Direction}</td>
                <td>{$document->TargetWarehouse}</td>
                <td>{$document->DatPorizeni|date:'d.m.Y'}</td>
                <td><a n:href="selectReceipt! $document->ID" class="btn btn-primary">Kontrola palet</a></td>
            </tr>
            <tr n:if="!count($documents)"><td colspan="5">Žádné výdejky nečekají na kontrolu příjmu.</td></tr>
        </tbody>
    </table>
    <a n:href="Material:default" class="btn btn-secondary">Zpět do skladu</a>
</div>
