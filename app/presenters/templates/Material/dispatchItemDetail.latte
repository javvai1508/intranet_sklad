{block content}

<div class="content">
            <div class="row delivery-note-header">
                <div class="col-sm-12">
                {if $dispatchType == 'toSchenker'}
                    <div class="float-right delivery-note-status"><h1 class="text-danger">Počet palet: {$dispatch->PocetPalet}</h1></div>
                    <h1>Do Schenkeru</h1> 
                {elseif $dispatchType == 'fromSchenker'}
                    <div class="float-right delivery-note-status"><h1 class="text-danger">Palety: {$dispatch->Priprava}/{$dispatch->PocetPalet}</h1></div>
                    <h1>Ze Schenkeru</h1> 
                {elseif $dispatchType == 'delivery'}
                    <div class="float-right delivery-note-status"><h1 class="text-danger">Palety: {$dispatch->Priprava}/{$dispatch->PocetPalet}</h1></div>
                    <h1>Dodací list</h1> 
                {else}
                {/if}
                </div>
            </div>
    <div class="row delivery-note-items">
        <div class="col-sm-12">
            <h5>Detail položky výdejky</h5>
            {if $dispatchType == 'toSchenker'}
            <table class="table table-bordered table-striped table-sm">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Název</th>
                        <th scope="col">Množství / palety</th>

                    </tr>
                </thead>
                <tbody>
                    {if isset($dispatchItem)}
                        <tr>
                            <td class="text-center">{$dispatchItem->Nazev}</td>
                            <td class="text-center">{$dispatchItem->Mnozstvi|number:2} / {$dispatchItem->PocetPalet}</td>

                        </tr>
                    {/if}
                </tbody>
            </table>
            {elseif $dispatchType == 'fromSchenker'}
            <table class="table table-bordered table-striped table-sm">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Název</th>
                        <th scope="col">Palety</th>

                    </tr>
                </thead>
                <tbody>
                    {if isset($dispatchItem)}
                        <tr>
                            <td class="text-center">{$dispatchItem->Nazev}</td>
                            <td class="text-center">{$dispatchItem->Priprava} / {$dispatchItem->PocetPalet}</td>

                        </tr>
                    {/if}
                </tbody>
            </table>
            {/if}
        </div>
    </div>
    <div class="row delivery-note-item-sn">
        <div class="col-sm-12">
            <div class="row">
                <div class="col-sm-12"><h5>Palety</h5></div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="set-dn-form">

                    </div>
                </div>
            </div>
            {snippet itemSNTable}
                <table class="table table-bordered table-striped table-sm">
                    <thead class="thead-light">
                        <tr>
                            <th scope="col">Číslo palety</th>
                            <th scope="col">Množství</th>
                            <th scope="col" class="text-right">
                                <a n:href="Material:showDispatch" class="btn btn-sm btn-primary mr-2"><i class="far fa-level-up"></i></a>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach $dispatchItemSNs as $dispatchItemSN}
                            <tr>
                                <td class="text-center">{$dispatchItemSN->Nazev}</td>
                                {if $dispatchType == 'toSchenker'}
                                <td class="text-center font-weight-bold">{$dispatchItemSN->Mnozstvi|number:2}</td>
                                {elseif $dispatchType == 'fromSchenker'}
                                <td class="text-center font-weight-bold">{$dispatchItemSN->PripravaMnoz|number:2}/{$dispatchItemSN->Mnozstvi|number:2}</td>
                                {/if}
                                <td class="text-center text-nowrap">
                                    <a n:href="removeDispatchItemSN! $dispatchItem->DispatchItemID, $dispatchItemSN->IDVyrCP" n:if="($dispatch->StavDispExp == 0)" class="btn btn-sm btn-danger mr-2" data-nette-confirm="modal" data-nette-confirm-title="Odebrat výrobní číslo z výdejky" data-nette-confirm-text="Opravdu chcete zrušit výrobní číslo z výdejky?" data-nette-confirm-ok-class="btn-danger" data-nette-confirm-ok-text="Ano" data-nette-confirm-cancel-class="btn-secondary" data-nette-confirm-cancel-text="Ne"><i class="far fa-trash-alt"></i></a>
                                </td>
                            </tr>
                        {/foreach}
                    </tbody>
                </table>
            {/snippet}
        </div>
    </div>
</div>
