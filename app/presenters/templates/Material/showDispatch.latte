{block content}
<div class="content">
    {ifset $dispatch->ID}
            <div class="row delivery-note-header">
                <div class="col-sm-12">
                {if $isOutgoingTransfer}
                    <div class="float-right delivery-note-status"><h1 class="text-danger">Počet palet: {$dispatch->PocetPalet}</h1></div>
                    <h1>{$transferTitle}</h1> 
                {elseif $dispatchType == 'fromSchenker'}
                    <div class="float-right delivery-note-status"><h1 class="text-danger">Palety: {$dispatch->Priprava}/{$dispatch->PocetPalet}</h1></div>
                    <h1>Ze Schenkeru</h1> 
                {elseif $dispatchType == 'delivery'}
                    <div class="float-right delivery-note-status"><h1 class="text-danger">Palety: {$dispatch->Priprava}/{$dispatch->PocetPalet}</h1></div>
                    <h1>Dodací list</h1> 
                {else}
                {/if}
                </div>
            </div>
            <div class="row delivery-note-status">
                <div class="col-sm-12">
                    {if $dispatch->StavDispExp !== 1}
                        <div class="set-dn-form">
                            {include '../../templates/components/readBarCodeForm.latte', form => readBarCodeForm}
                        </div>
                    {/if}
                </div>
            </div>
        {if $isOutgoingTransfer}
        <div class="delivery-note-content">
            <div class="row delivery-note-items">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Název</th>
                                <th scope="col">Množství / palety</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $dispatchItems as $dispatchItem}
                                <tr class="position-relative clickable-row" >
                                    <td class="text-center">{$dispatchItem->Nazev}</td>
                                    <td class="text-center font-weight-bold ">{$dispatchItem->Mnozstvi|number:2} / {$dispatchItem->PocetPalet}</td>
                                    <td><a n:href="dispatchItemDetail $dispatchItem->DispatchItemID" class="stretched-link"></a></td>
                                    <!-- td class="text-right text-nowrap">
                                        <a n:href="dispatchItemDetail $dispatchItem->DispatchItemID" class="btn btn-lg btn-primary mr-2"><i class="far fa-info"></i></a>
                                        <a n:href="removeDispatchItem! $dispatchItem->DispatchItemID" n:if="($dispatch->StavDispExp == 0)" class="btn btn-lg btn-danger mr-2 ajax" data-nette-confirm="modal" data-nette-confirm-title="Zrušení výdeje položky" data-nette-confirm-text="Opravu chcete zrušit výdej u vybrané položky?" data-nette-confirm-ok-class="btn-danger" data-nette-confirm-ok-text="Ano" data-nette-confirm-cancel-class="btn-secondary" data-nette-confirm-cancel-text="Ne"><i class="far fa-trash-alt"></i></a>
                                    </td -->
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {elseif $dispatchType == 'fromSchenker'}
        <div class="delivery-note-content">
            <div class="row delivery-note-items">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Název</th>
                                <th scope="col">Množství</th>
                                <th scope="col">Palety</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $dispatchItems as $dispatchItem}
                                <tr class="clickable-row" data-href="{link dispatchItemDetail $dispatchItem->DispatchItemID}">
                                    <td class="text-center">{$dispatchItem->Nazev}</td>
                                    <td class="text-center font-weight-bold ">{$dispatchItem->PripravaMnoz|number:2} / {$dispatchItem->Mnozstvi|number:2}</td>
                                    <td class="text-center font-weight-bold ">{$dispatchItem->Priprava} / {$dispatchItem->PocetPalet}</td>
                                    <!-- td class="text-right text-nowrap">
                                        <a n:href="dispatchItemDetail $dispatchItem->DispatchItemID" class="btn btn-lg btn-primary mr-2"><i class="far fa-info"></i></a>
                                        <a n:href="removeDispatchItem! $dispatchItem->DispatchItemID" n:if="($dispatch->StavDispExp == 0)" class="btn btn-lg btn-danger mr-2 ajax" data-nette-confirm="modal" data-nette-confirm-title="Zrušení výdeje položky" data-nette-confirm-text="Opravu chcete zrušit výdej u vybrané položky?" data-nette-confirm-ok-class="btn-danger" data-nette-confirm-ok-text="Ano" data-nette-confirm-cancel-class="btn-secondary" data-nette-confirm-cancel-text="Ne"><i class="far fa-trash-alt"></i></a>
                                    </td -->
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {elseif $dispatchType == 'receipt'}
        <div class="delivery-note-content">
            <div class="row delivery-note-items">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Název</th>
                                <th scope="col">Množství</th>
                                <th scope="col">Palety</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $dispatchItems as $dispatchItem}
                                <tr class="clickable-row" data-href="{link dispatchItemDetail $dispatchItem->DispatchItemID}">
                                    <td class="text-center">{$dispatchItem->Nazev}</td>
                                    <td class="text-center font-weight-bold ">{$dispatchItem->PripravaMnoz|number:2} / {$dispatchItem->Mnozstvi|number:2}</td>
                                    <td class="text-center font-weight-bold ">{$dispatchItem->Priprava} / {$dispatchItem->PocetPalet}</td>
                                    <!-- td class="text-right text-nowrap">
                                        <a n:href="dispatchItemDetail $dispatchItem->DispatchItemID" class="btn btn-lg btn-primary mr-2"><i class="far fa-info"></i></a>
                                        <a n:href="removeDispatchItem! $dispatchItem->DispatchItemID" n:if="($dispatch->StavDispExp == 0)" class="btn btn-lg btn-danger mr-2 ajax" data-nette-confirm="modal" data-nette-confirm-title="Zrušení výdeje položky" data-nette-confirm-text="Opravu chcete zrušit výdej u vybrané položky?" data-nette-confirm-ok-class="btn-danger" data-nette-confirm-ok-text="Ano" data-nette-confirm-cancel-class="btn-secondary" data-nette-confirm-cancel-text="Ne"><i class="far fa-trash-alt"></i></a>
                                    </td -->
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {elseif $dispatchType == 'delivery'}
        <div class="delivery-note-content">
            <div class="row delivery-note-items">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped table-sm">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">Název</th>
                                <th scope="col">Množství</th>
                                <th scope="col">Palety</th>
                            </tr>
                        </thead>
                        <tbody>
                            {foreach $dispatchItems as $dispatchItem}
                                <tr class="clickable-row" data-href="{link dispatchItemDetail $dispatchItem->DispatchItemID}">
                                    <td class="text-center">{$dispatchItem->Nazev}</td>
                                    <td class="text-center font-weight-bold ">{$dispatchItem->PripravaMnoz|number:2} / {$dispatchItem->Mnozstvi|number:2}</td>
                                    <td class="text-center font-weight-bold ">{$dispatchItem->Priprava} / {$dispatchItem->PocetPalet}</td>
                                    <!-- td class="text-right text-nowrap">
                                        <a n:href="dispatchItemDetail $dispatchItem->DispatchItemID" class="btn btn-lg btn-primary mr-2"><i class="far fa-info"></i></a>
                                        <a n:href="removeDispatchItem! $dispatchItem->DispatchItemID" n:if="($dispatch->StavDispExp == 0)" class="btn btn-lg btn-danger mr-2 ajax" data-nette-confirm="modal" data-nette-confirm-title="Zrušení výdeje položky" data-nette-confirm-text="Opravu chcete zrušit výdej u vybrané položky?" data-nette-confirm-ok-class="btn-danger" data-nette-confirm-ok-text="Ano" data-nette-confirm-cancel-class="btn-secondary" data-nette-confirm-cancel-text="Ne"><i class="far fa-trash-alt"></i></a>
                                    </td -->
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {/if}
                <div class="text-center">
                    <a n:if="$dispatchType === 'toLoukov' && $dispatch->StavDispExp == 1" n:href="LoukovReceipt:default" class="btn btn-primary btn-lg m-1">Příjem v Loukově</a>
                    <a n:href="default" class="btn btn-secondary btn-lg m-1"><i class="far fa-chevron-left"></i> Zpět</a>
                    {if $dispatch->StavDispExp == 1}
                        <span class="text-danger font-weight-bold">Uzavřeno: {$dispatch->DatUzavrenoExp}</span>
                    {else}
                    <a n:href="closeDispatch!" n:if="($dispatch->StavDispExp == 0)" class="btn btn-success btn-lg m-1"><i class="far fa-forklift"></i> Uzavřít doklad</a>
                    {/if}
                </div>
    {/ifset}
</div>
